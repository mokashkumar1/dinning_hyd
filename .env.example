# ==============================================================================
# ShifaAI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and configure your credentials.
#
# QUICK START FOR JUDGES:
# You can run ShifaAI immediately with DEMO_MODE=true even without external API
# keys; the application will automatically engage its zero-crash clinical fallback
# and seeded local datasets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Database & Authentication (Required for Live DB Operations)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-only Service Role Key (Used for backend user management & demo seed)
# CRITICAL: Never prefix this key with NEXT_PUBLIC_ or commit it to source control.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# Google Gemini Multimodal Vision & TTS (Optional for Live Prescription OCR)
# ------------------------------------------------------------------------------
# Server-only keys. Comma-separate multiple keys for automatic failover.
GEMINI_API_KEYS=PASTE_KEY_1,PASTE_KEY_2,PASTE_KEY_3
# Legacy fallback supported if GEMINI_API_KEYS is unavailable.
GEMINI_API_KEY=
# Gemini 2.5 Flash remains the preferred main-generation model.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
# Speech uses a dedicated TTS chain. It does not change the main model above.
GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-2.5-flash-preview-tts

# ------------------------------------------------------------------------------
# Application Base URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Hackathon Judge Demo Mode Flags
# ------------------------------------------------------------------------------
# Set to 'true' to expose 1-click judge credentials on the /staff page and run
# automated idempotent database seeding during development and production builds.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
